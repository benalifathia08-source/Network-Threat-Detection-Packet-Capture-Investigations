  <!-- NTD (Project 4): Suricata and Zeek output of offline case analysis.
       Each file gets labels so Wazuh rules can tell the sensors and Zeek log types apart.
       Wildcards: the agent re-checks them about every minute, so a new case is picked
       up on its own. Hidden ".tmp-*" folders (analysis still running) never match. -->
  <localfile>
    <log_format>json</log_format>
    <location>/var/log/nsm/cases/*/suricata/alerts.json</location>
    <label key="nsm.sensor">suricata</label>
  </localfile>
  <localfile>
    <log_format>json</log_format>
    <location>/var/log/nsm/cases/*/zeek/conn.log</location>
    <label key="nsm.sensor">zeek</label>
    <label key="nsm.log">conn</label>
  </localfile>
